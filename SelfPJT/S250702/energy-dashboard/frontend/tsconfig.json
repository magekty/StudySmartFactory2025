// frontend/tsconfig.json (수정)
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true, // 이 줄은 유지합니다.
    "jsx": "react-jsx", // 이 설정도 그대로 둡니다.

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true, // 이 줄이 있는지 확인하고 있다면 그대로 둡니다.
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
  // "references": [{ "path": "./tsconfig.node.json" }] // !!! 이 줄을 삭제합니다 !!!
}
